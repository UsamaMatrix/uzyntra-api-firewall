APP_CONFIG_PATH=config/development.yaml
FIREWALL_PUBLIC_BIND_ADDR=127.0.0.1:8080
FIREWALL_ADMIN_BIND_ADDR=127.0.0.1:9090
FIREWALL_ADMIN_TOKEN=<admin-token>
FIREWALL_API_KEYS=<api-key-1>,<api-key-2>
UPSTREAM_BASE_URL=https://httpbin.org
RUST_LOG=info
UZYNTRA_CONTROL_PLANE_TELEMETRY_ENABLED=false
UZYNTRA_CONTROL_PLANE_INGEST_URL=http://localhost:3000/api/ingest/security-events
UZYNTRA_CONTROL_PLANE_API_KEY=<service-account-api-key>
UZYNTRA_FIREWALL_INSTANCE_ID=<firewall-instance-id>
